#!/bin/sh
#
# Regenerates ev_wrap.h from ev_vars.h.
#
# Three defects were found in this script by requiring it to reproduce the committed
# ev_wrap.h byte for byte, which it had never been asked to do:
#
#   * the symbol regex was /(^\w+)/, which assumes the preprocessor emits one bare name
#     per line starting at column 0. Clang preserves ev_vars.h's own indentation and keeps
#     names that shared a source line together, so it collected 1 symbol out of 129 -- a
#     run of this script would have replaced the whole accessor set with a single macro.
#   * the SPDX and libev attribution header was not emitted at all. ev_wrap.h is a derived
#     file and that notice is what discharges the BSD-2 obligation for it.
#   * the include guard came out EV_WRAP_H, not the QB_EV_WRAP_H the tree renamed it to,
#     and the banner named a script called update_qev_wrap, which has never existed.
#
# It writes to a temporary file and moves it into place only on success: a failed run must
# not leave a truncated ev_wrap.h behind, which is exactly what the first repair did.

set -e

expected=$(grep -cE '^[[:space:]]*VARx?[[:space:]]*\(' ev_vars.h)
tmp=ev_wrap.h.tmp
trap 'rm -f "$tmp"' EXIT

cat >"$tmp" <<'HEADER'
/*
 * loop member variable accessor macros
 *
 * SPDX-License-Identifier: MIT
 * Copyright (c) 2011-2026 qb - isndev (cpp.actor).
 *
 * Part of qev, a modernized cross-platform fork of libev.
 * Based on libev by Marc Alexander Lehmann <libev@schmorp.de>.
 *   Upstream: http://software.schmorp.de/pkg/libev.html
 *
 * Released under the MIT License (see LICENSE). Portions derived from libev
 * remain Copyright (c) Marc Alexander Lehmann under the BSD-2-Clause license;
 * see THIRD-PARTY-NOTICES.
 */

HEADER

(
   echo '#define VAR(name,decl) name'
   echo '#define EV_GENWRAP 1'
   cat ev_vars.h
) | cc -E -o - - | EXPECTED="$expected" perl -ne '
   next if /^\s*#/;                 # preprocessor linemarkers, not content
   push @syms, /(\w+)/g;
   END {
      my %seen; @syms = sort grep { !$seen{$_}++ } @syms;
      my $want = $ENV{EXPECTED} || 0;
      die "update_ev_wrap: got " . scalar(@syms) . " symbols but ev_vars.h declares $want; "
        . "refusing to write\n" if @syms < $want;
      print "/* DO NOT EDIT, automatically generated by update_ev_wrap */\n",
            "#ifndef QB_EV_WRAP_H\n",
            "#define QB_EV_WRAP_H\n",
            (map "#define $_ ((loop)->$_)\n", @syms),
            "#else\n",
            "#undef QB_EV_WRAP_H\n",
            (map "#undef $_\n", @syms),
            "#endif\n";
   }
' >>"$tmp"

mv "$tmp" ev_wrap.h
trap - EXIT
